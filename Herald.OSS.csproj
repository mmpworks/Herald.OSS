<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MMP.Herald</RootNamespace>
    <AssemblyName>Herald.OSS</AssemblyName>
    <PackageId>Herald.OSS</PackageId>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <Description>Herald.OSS - Open-source Apache 2.0 upstream of the Herald structured-logging core for .NET.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Authors>Steven Muchow</Authors>
    <Company>MMPWorks LLC</Company>
    <Copyright>Copyright (c) 2026 MMPWorks LLC</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mmpworks/Herald.OSS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mmpworks/Herald.OSS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>logging;structured-logging;dotnet;aot;trim-safe;serilog-alternative;nlog-alternative;observability;telemetry;zero-allocation;kernel;herald</PackageTags>
    <PackageReleaseNotes>https://github.com/mmpworks/Herald.OSS/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/$(Configuration)/$(TargetFramework)/generated</CompilerGeneratedFilesOutputPath>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL3050;IL2046;IL2057</WarningsNotAsErrors>

    <!--
      Same item-glob filtering as upstream Herald.Core: keep MSBuild from
      walking sibling folders that aren't part of the compile.

      tests/       : own csproj if/when added.
      benchmarks/  : own csproj if/when added.
      generators/  : separate csproj referenced below.
      docs/        : excluded from compile. Seeded since 0.1.0 — see
                     docs/howtos, docs/guides, docs/benchmarks for shipped
                     content. Exclusion keeps markdown out of MSBuild item
                     enumeration; the README is packed separately below.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;benchmarks\**;benchmarking\**;bench\**;generators\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Superpower" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local source-generator project. Same shape as upstream Herald.Core.
         OutputItemType="Analyzer" wires the generator into THIS compile;
         the <None ... PackagePath="analyzers/dotnet/cs" /> item below ships
         the same DLL inside the Herald.OSS nupkg so downstream consumers
         (Herald.Sinks.*, Compliance, sample apps) get the [ModuleInitializer]
         auto-registration generator without a separate analyzer-package
         dependency. -->
    <ProjectReference Include="generators\MMP.Herald.OSS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the source generator inside the Herald.OSS nupkg. NuGet looks
       up analyzers/dotnet/cs/ at consumer build time and loads every DLL
       it finds as a Roslyn analyzer. Without this, the runtime DLL flows
       to consumers but the generator does not, and the per-sink
       [ModuleInitializer] never gets emitted — failure mode is empty
       LogSinkProviderRegistry.Default on assembly load. -->
  <ItemGroup>
    <None Include="generators\bin\$(Configuration)\netstandard2.0\MMP.Herald.OSS.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <!-- InternalsVisibleTo grants.
       Phase 1.5 will add PublicKey qualifiers to every entry once R17
       key-rotation runbook and strong-name key infrastructure land
       (Max + Steve own). Today sibling is unsigned; source-level-fork
       attack surface stays open in the interim. Phase 1 stays internal;
       no nuget publish past v0.4.0 happens until Phase 1.5 closes. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Herald.OSS.Tests" />
    <InternalsVisibleTo Include="Herald.Sci" />
    <InternalsVisibleTo Include="MMP.Herald.Pro" />
    <InternalsVisibleTo Include="MMP.Herald.Enterprise" />
    <!-- Stage 2 will rename to Herald.ServerOSS + MMP.Herald.Server.Pro + MMP.Herald.Server.Enterprise; revisit at carve commit -->
    <InternalsVisibleTo Include="Herald.ManagementApi" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Auto-applied props for downstream consumers. Drops MMP.Herald.Generated
       into the consumer's InterceptorsNamespaces so the interceptor generator's
       emitted [InterceptsLocation] attributes are honored at compile time.
       Without this, a consumer who takes a PackageReference on Herald.OSS gets
       the analyzer DLL but the compiler discards every interceptor for
       lack of an opt-in namespace — failure mode is "interceptors never fire,
       calls fall through to runtime resolver."  -->
  <ItemGroup>
    <None Include="buildTransitive\Herald.OSS.props"
          Pack="true"
          PackagePath="buildTransitive/$(PackageId).props"
          Visible="false" />
  </ItemGroup>

  <!-- Auto-applied targets for downstream consumers. Validates the
       <HeraldPipelineComposition> property and emits the matching
       [assembly: HeraldPipelineCompositionAttribute] so a host process can
       observe at runtime which composition shape the assembly was built
       against. PackagePath is build/ (not buildTransitive/) because
       AssemblyAttribute items must be visible to the consumer's compile,
       not just to its dependents — NuGet imports build/$(PackageId).targets
       directly into the consumer's project. -->
  <ItemGroup>
    <None Include="build\Herald.OSS.targets"
          Pack="true"
          PackagePath="build/$(PackageId).targets"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\Addons\ManagementApi\SampleLogs\*.log"
                      Condition="Exists('src\Addons\ManagementApi\SampleLogs')" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifests\pipeline\*.mmpform"
                      Condition="Exists('manifests\pipeline')">
      <LogicalName>manifests/pipeline/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
