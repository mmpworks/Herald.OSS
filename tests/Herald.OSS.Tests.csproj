<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MMP.Herald.OSS.Tests</RootNamespace>
    <AssemblyName>Herald.OSS.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- HERALD004: tests intentionally build pipelines without sinks.
         xUnit1031: blocking .Wait() acceptable when probing backpressure. -->
    <NoWarn>HERALD004;xUnit1031</NoWarn>

    <!-- Interceptor opt-in. The runtime Herald.OSS package ships a
         buildTransitive/Herald.OSS.props that auto-applies this for NuGet
         consumers; tests reach the generator through a ProjectReference
         (not a PackageReference), so we wire the namespace manually here.
         Without this, the InterceptorGenerator's emitted [InterceptsLocation]
         attributes produce CS9137 build errors. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);MMP.Herald.Generated</InterceptorsNamespaces>

    <!-- tests/Pipeline/ExternalEventInjectionTests.cs deliberately calls
         AllowExternalEventInjection() to exercise the runtime injection path.
         This is the blessed assembly-wide acknowledgement of HRLD0060
         (TreatWarningsAsErrors would otherwise turn the nudge into a build
         error here). It suppresses the analyzer only; it does not change
         runtime behaviour. Mirrors what a real consumer that uses the switch
         would set. -->
    <HeraldAllowExternalInjection>true</HeraldAllowExternalInjection>

    <!-- tests/AOT/ is its own csproj (Herald.OSS.Aot.Tests). Exclude its
         sources from this xUnit project so the default **/*.cs glob does
         not double-include Program.cs / cause duplicate AssemblyInfo.
         Same exclusion applies to the other sidecar smoke-test exe
         projects (Interceptor.SmokeTests, Interceptor.AssertionSmoke,
         Install). -->
    <!-- AspNetCore\ is its own csproj (Herald.OSS.Serilog.AspNetCore.Tests).
         Exclude so the **/*.cs glob does not pull in files that require
         FrameworkReference Microsoft.AspNetCore.App and TestServer. -->
    <!-- SerilogCompat\** contains the intentionally-broken CoexistenceConflict project
         (G-LAYER2.1). Its UsesSerilogType.cs must not be compiled into this project —
         it references both Serilog assemblies and would trigger CS0433 here too.
         The meta-test (G_Layer2_CoexistenceTests.cs) lives in tests/Serilog/ and IS
         picked up by this project. -->
    <!-- Layer2CorpusTests\** is its own test project (Herald.OSS.Layer2.Corpus.Tests.csproj).
         Exclude so the default glob does not pull in its source files or generated obj\
         AssemblyInfo artifacts (which cause CS0579 duplicate-attribute errors here). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);AOT\**;Interceptor.SmokeTests\**;Interceptor.AssertionSmoke\**;Install\**;AspNetCore\**;SerilogCompat\**;Layer2CorpusTests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Surface the Herald MSBuild properties to the source generators —
         mirror of the buildTransitive/Herald.OSS.props NuGet consumers get. -->
    <CompilerVisibleProperty Include="HeraldInterceptorsEnabled" />
    <CompilerVisibleProperty Include="HeraldStrictMode" />
    <CompilerVisibleProperty Include="HeraldNamingPolicyAssertion" />
    <CompilerVisibleProperty Include="HeraldAllowExternalInjection" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog 4.3.1 — parity oracle for G-VM.* tests.
         Coexists with MMP.Herald.Serilog because namespaces are distinct. -->
    <PackageReference Include="Serilog" />
    <!-- Serilog.Formatting.Compact 3.0.0 — CLEF oracle for P3 Task 8 parity tests.
         Test-project only; never referenced from the product compat assembly. -->
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Herald.OSS.csproj" />
    <!-- Layer-1 compat shim under test. Linked on all TFMs: MMP.Herald.Serilog
         is now a forwarding shim (no source; the Serilog API surface lives in
         Herald.OSS) and targets net8/net9/net10. The Serilog-compat test suite
         runs on net8 too, so the shim must be referenced on net8. -->
    <ProjectReference Include="..\src\Serilog\MMP.Herald.Serilog.csproj" />
    <!-- Attach the source generators so tests can exercise [HeraldLog]
         partial methods end-to-end. Same shape Herald.OSS uses to pull
         in its own generators — Analyzer output, no reference assembly. -->
    <ProjectReference Include="..\generators\MMP.Herald.OSS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Also reference the generator assembly normally so the golden-file
         tests in tests/Generators/ can construct generator instances
         directly through a Roslyn CSharpGeneratorDriver. Aliased to avoid
         the analyzer-vs-runtime duplicate-load surface; the test reaches
         the type via the GeneratorReference alias. -->
    <ProjectReference Include="..\generators\MMP.Herald.OSS.Generators.csproj"
                      ReferenceOutputAssembly="true"
                      PrivateAssets="all"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>
</Project>
