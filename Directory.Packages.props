<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core runtime dependencies (mirrors upstream Herald.Core pins) -->
    <PackageVersion Include="Google.Protobuf" Version="3.34.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Superpower" Version="3.0.0" />

    <!-- Source-generator dev-time dependency (analyzers/dotnet/cs target) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />

    <!-- Benchmark-project dependency. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />

    <!-- Comparison-suite competitor pins. Transitive only to the
         per-competitor csprojs under benchmarking/comparisons/net10/.
         Never referenced by Herald.OSS.csproj, the library benches,
         or the test suite. -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="NLog" Version="5.5.1" />
    <PackageVersion Include="ZLogger" Version="2.5.10" />
    <PackageVersion Include="log4net" Version="3.0.3" />

    <!-- AspNetCore-compat project dependencies.
         Microsoft.AspNetCore.Http.Abstractions was frozen at 2.3.x and is not
         published for net9+; use FrameworkReference Include="Microsoft.AspNetCore.App"
         in the product project instead. Microsoft.Extensions.Hosting.Abstractions
         flows through Microsoft.AspNetCore.App (NU1510 fires on an explicit pin).
         TestHost is a real NuGet package consumed only by the test project. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="9.0.0" />

    <!-- Settings-compat project dependencies. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />

    <!-- Test-project dependencies (consumed by tests/Herald.OSS.Tests.csproj). -->
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
