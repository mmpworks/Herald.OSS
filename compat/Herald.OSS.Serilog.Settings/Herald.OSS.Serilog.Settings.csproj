<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Herald.OSS.Serilog.Settings</RootNamespace>
    <AssemblyName>Herald.OSS.Serilog.Settings</AssemblyName>
    <PackageId>Herald.OSS.Serilog.Settings</PackageId>
    <IsPackable>true</IsPackable>
    <Version>0.12.7</Version>
    <PackageProjectUrl>https://github.com/mmpworks/Herald.OSS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mmpworks/Herald.OSS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- net8/net9/net10 — matches the Layer-1 shim (MMP.Herald.Serilog) and
         Herald.OSS core, both of which already target net8. net8 is an
         ASP.NET Core LTS and the binding APIs used here resolve on net8. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Description>Apache-2.0 appsettings.json binding for the Herald.OSS Serilog-compat shim.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>Steven Muchow</Authors>
    <Company>MMPWorks LLC</Company>
    <Copyright>Copyright (c) 2026 MMPWorks LLC</Copyright>

    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Mirror Layer-1 IL-trimming suppression list. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL3050;IL2046;IL2057</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal types (SerilogConfigurationReader) to the test project. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Herald.OSS.Serilog.Settings.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Layer-1 Serilog-compat shim — the skin this settings layer configures. -->
    <ProjectReference Include="..\..\src\Serilog\MMP.Herald.Serilog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
  </ItemGroup>
</Project>
