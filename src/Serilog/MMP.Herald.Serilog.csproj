<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Forwarding shim — the Serilog API surface (ILogger, Log, LoggerConfiguration,
         SerilogLoggerAdapter) now ships directly inside Herald.OSS. This package
         exists for backward compatibility: consumers who already reference
         MMP.Herald.Serilog will get Herald.OSS (and its full Serilog surface)
         transitively. New consumers should add Herald.OSS directly. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>

    <RootNamespace>MMP.Herald.Serilog</RootNamespace>
    <AssemblyName>MMP.Herald.Serilog</AssemblyName>

    <PackageId>MMP.Herald.Serilog</PackageId>
    <IsPackable>true</IsPackable>
    <Version>0.12.0</Version>
    <Authors>Steven Muchow</Authors>
    <Company>MMPWorks LLC</Company>
    <Copyright>Copyright (c) 2026 MMPWorks LLC</Copyright>
    <Description>Forwarding shim — the Serilog API surface is now included in Herald.OSS directly. Add Herald.OSS instead of this package for new projects.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mmpworks/Herald.OSS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mmpworks/Herald.OSS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- No source — all Serilog API types now live in Herald.OSS assembly. -->
  <ItemGroup>
    <Compile Remove="**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Herald.OSS.csproj" />
  </ItemGroup>
</Project>
