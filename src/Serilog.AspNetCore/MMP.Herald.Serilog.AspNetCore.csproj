<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Layer-2 ASP.NET Core Serilog-compat skin: net9+net10 ONLY.
         TargetFrameworks is set directly here so Directory.Build.props
         (which sets TargetFrameworks=$(HeraldTargetFrameworks) at import
         time) cannot include net8. Setting HeraldTargetFrameworks too so
         any downstream conditional logic sees the intent. -->
    <HeraldTargetFrameworks>net9.0;net10.0</HeraldTargetFrameworks>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>

    <!-- Consumer-facing surface lives in Serilog / Microsoft.Extensions.* /
         Microsoft.AspNetCore.* namespaces — RootNamespace is Serilog so the
         compiler's default namespace matches the public API shape. -->
    <RootNamespace>Serilog</RootNamespace>
    <AssemblyName>MMP.Herald.Serilog.AspNetCore</AssemblyName>

    <!-- Pack metadata. Distributable: assembly name is
         MMP.Herald.Serilog.AspNetCore (NOT "Serilog.AspNetCore"), so no
         NuGet identity collision with the real package. Mirrors Herald.OSS.csproj. -->
    <PackageId>MMP.Herald.Serilog.AspNetCore</PackageId>
    <IsPackable>true</IsPackable>
    <Version>0.12.0</Version>
    <Authors>Steven Muchow</Authors>
    <Company>MMPWorks LLC</Company>
    <Copyright>Copyright (c) 2026 MMPWorks LLC</Copyright>
    <Description>Herald.OSS Serilog.AspNetCore-compat skin — UseSerilog() hosting, request logging, and middleware wiring backed by the Herald.OSS structured-logging core. Apache-2.0.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mmpworks/Herald.OSS</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mmpworks/Herald.OSS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/$(Configuration)/$(TargetFramework)/generated</CompilerGeneratedFilesOutputPath>

    <!-- Mirror Herald.OSS.csproj IL-trimming suppression list. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL3050;IL2046;IL2057</WarningsNotAsErrors>

    <!-- Exclude tests/generators/docs from this project's compile glob. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;benchmarks\**;generators\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Herald.OSS engine — the substrate this compat skin runs on. -->
    <ProjectReference Include="..\..\Herald.OSS.csproj" />
    <!-- Layer-1 Serilog-compat shim — P1/P2 types (LoggerConfiguration, ILogger, etc.)
         that this ASP.NET Core layer extends with hosting and middleware integration. -->
    <ProjectReference Include="..\Serilog\MMP.Herald.Serilog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.App shared framework reference — supplies
         IApplicationBuilder, IWebHostEnvironment, HttpContext, and all other
         ASP.NET Core types. FrameworkReference is the correct primitive for
         net9/net10 class libraries; the individual AspNetCore.Http.* packages
         were frozen at their legacy versions and are not net9/net10 compatible. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Logging — UseSerilog() wires Herald into the
         ILoggerFactory / IHostBuilder pipeline.
         Microsoft.Extensions.Hosting.Abstractions is NOT listed explicitly:
         it flows through Microsoft.AspNetCore.App and NU1510 fires when it is
         also an explicit PackageReference (TreatWarningsAsErrors is on). -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
