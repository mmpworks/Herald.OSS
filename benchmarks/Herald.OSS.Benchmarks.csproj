<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MMP.Herald.OSS.Benchmarks</RootNamespace>
    <AssemblyName>Herald.OSS.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Benchmarks run on net10.0 only — the canonical accept-path
         numbers are net10 numbers. Adding net8 / net9 multi-target
         would dilute the reading without a useful comparison. -->
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Herald.OSS.csproj" />
  </ItemGroup>
</Project>
