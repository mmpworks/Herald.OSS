<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Ref1.Worker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Serilog -> Herald: the package swap. Same call sites, same appsettings.json. -->
    <PackageReference Include="MMP.Herald.Serilog" Version="0.12.5" />
    <PackageReference Include="Herald.OSS.Serilog.Settings" Version="0.12.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
</Project>
