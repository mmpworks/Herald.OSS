<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Source generators must target netstandard2.0 only - override multi-targeting -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks />
    <HeraldTargetFrameworks />
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Generators use Roslyn APIs that produce different warnings -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <RootNamespace>MMP.Herald.Generators</RootNamespace>
    <AssemblyName>MMP.Herald.Generators</AssemblyName>

    <!-- Mark as analyzer so it runs at compile time, not runtime -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- Never ship to consumer runtime -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>

    <!-- Analyzer NuGet metadata. The package is what downstream consumers
         reference when they want AOT publish to work — a PackageReference
         to an analyzer nupkg does not pull the netstandard2.0 project
         into the AOT graph the way a ProjectReference does. See
         docs/aot-readiness.md in Herald.Core for the full story. -->
    <IsPackable>true</IsPackable>
    <PackageId>MMP.Herald.Generators</PackageId>
    <Version>1.0.0</Version>
    <Authors>MMP</Authors>
    <Description>Source generators for Herald.Core. AOT-safe analyzer package.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <!--
      Filter the default item globs at evaluation time so MSBuild never
      walks sibling folders that belong to other projects. This replaces
      the <Compile Remove> line; Remove fires after the glob enumeration.

      tests/ - has its own MMP.Herald.Generators.Tests.csproj.
      docs/  - markdown only; not part of the compile.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;docs\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Pack the built DLL into analyzers/dotnet/cs/ inside the nupkg.
       That is the path the .NET SDK looks up at build time to load
       analyzers and source generators for any consumer that references
       the package. -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dev-time only: Roslyn APIs for source generation and analysis -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- Shared vocabularies with Core. Linked (not copied) so a rename in
       Core breaks this compile — preventing the analyzers from drifting
       onto names that no longer exist. Each linked file declares only
       const strings, which is netstandard2.0-safe. -->
  <ItemGroup>
    <Compile Include="..\Core\src\Pipeline\PipelineStepNames.cs"
             Link="Shared\PipelineStepNames.cs" />
    <Compile Include="..\Core\src\Levels\KnownLogLevelKeys.cs"
             Link="Shared\KnownLogLevelKeys.cs" />
  </ItemGroup>
</Project>
