<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MMP.Herald.OSS.Benchmarks.Comparisons.HeraldRow</RootNamespace>
    <AssemblyName>Herald.Comparison</AssemblyName>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- HERALD004 fires on the HotReload bench's Build().ExportConfig()
         calls that snapshot JSON configs. The chain wires WithNullSink
         but the analyzer matches a stricter pattern. Suppress in this
         bench project only. -->
    <NoWarn>$(NoWarn);HERALD004</NoWarn>

    <!-- Interceptor opt-in. Bench project reaches the generator through a
         ProjectReference (not a NuGet PackageReference), so the
         buildTransitive/Herald.OSS.props auto-import doesn't fire. Wire
         the namespace + compiler-visible properties by hand to keep the
         comparison numbers honest — without interceptors, the AcceptCall
         bench measures the runtime resolver path, not the headline
         compile-time-baked path Herald.OSS ships by default. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);MMP.Herald.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="HeraldInterceptorsEnabled" />
    <CompilerVisibleProperty Include="HeraldStrictMode" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="ZLogger" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <!--
    TEMPORARY (2026-05-16 bench-rerun): exclude SourceGenBenchmarks.cs from
    compilation. It uses [HeraldLog] which currently emits a call to the
    internal StructuredLogger.RecordCompileTimeResolution() from a generated
    file outside the assembly. Pre-existing visibility bug; out of scope for
    this rerun. AcceptCall + the other non-source-gen comparisons compile
    cleanly without this file.
  -->
  <ItemGroup>
    <Compile Remove="SourceGenBenchmarks.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Herald.OSS.csproj" />
    <!-- Source generator for [HeraldLog]: needed so the source-gen
         comparison bench can declare its static partial Info-style
         methods alongside ZLogger's [ZLoggerMessage] and MEL's
         [LoggerMessage]. -->
    <ProjectReference Include="..\..\..\..\generators\MMP.Herald.OSS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
