<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MMP.Herald.OSS.Benchmarks.Comparisons.SerilogCompatRow</RootNamespace>
    <AssemblyName>HeraldOSS.Bench.SerilogCompat</AssemblyName>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- HERALD004: suppress same as Herald.Comparison.csproj — WithNullSink
         usage triggers the stricter analyzer pattern on build configs. -->
    <NoWarn>$(NoWarn);HERALD004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- Two compat entry points are benched here, so both references are needed:
         1. Herald.OSS (direct) — the SHIPPED 0.12.0 surface. SerilogLoggerAdapter
            and its typed-args overloads compile into Herald.OSS as of 0.12.0, so
            the typed-adapter rows (SerilogDestructureBenchmarks /
            SerilogDestructureRejectedBenchmarks) bench exactly what a
            `dotnet add package Herald.OSS` consumer gets, plus QuickLogBuilder.
         2. Layer-2 mirror (assembly named "Serilog") — the zero-source-change
            drop-in. SerilogCompatSurfaceBenchmarks / SerilogCompatRejectBenchmarks
            compile existing `using Serilog; Log.Information(...)` code against this
            impersonator assembly, which is intentionally NOT on nuget.org (it would
            collide with real Serilog). MUST NOT add the real Serilog NuGet here —
            CS0433 on the "Serilog" assembly name. Herald.OSS is a different name,
            so it coexists with Layer-2 cleanly. -->
    <ProjectReference Include="..\..\..\..\Herald.OSS.csproj" />
    <ProjectReference Include="..\..\..\..\src\Compatibility\Layer2\Serilog\MMP.Herald.Compat.Serilog.csproj" />
    <!-- Source generator wired as Analyzer so SerilogLoggerAdapter's typed-args
         overloads are emitted. Same pattern as Herald.Comparison.csproj. -->
    <ProjectReference Include="..\..\..\..\generators\MMP.Herald.OSS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
